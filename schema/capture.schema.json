{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tribrach-dev/tribrach/schema/capture.schema.json",
  "title": "Tribrach capture, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repo", "commit", "path", "ranges", "snippet_sha256", "note", "kind", "source", "created_at"],
  "properties": {
    "version": { "const": 1 },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "name"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
      }
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
    },
    "ranges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end"],
        "properties": {
          "start": { "type": "integer", "minimum": 1 },
          "end": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "snippet_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "note": { "type": "string", "maxLength": 2000 },
    "kind": { "enum": ["behaviour", "code-shape", "unknown"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "reporter": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
