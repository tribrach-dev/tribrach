{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tribrach-dev/tribrach/schema/capture.schema.json",
  "title": "Tribrach capture, version 1",
  "description": "Generated from examples/capture-schema/CaptureSchema.lean; edit that file, not this one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "repo",
    "commit",
    "path",
    "ranges",
    "snippet_sha256",
    "note",
    "kind",
    "source",
    "created_at"
  ],
  "properties": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "format": "date-time"
    },
    "kind": { "enum": ["behaviour", "code-shape", "unknown"] },
    "note": { "type": "string", "maxLength": 2000 },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\\\x00-\\x1f\\u2028\\u2029]+$"
    },
    "ranges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end"],
        "properties": {
          "end": { "type": "integer", "minimum": 1, "format": "int64" },
          "start": { "type": "integer", "minimum": 1, "format": "int64" }
        }
      }
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "name"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
      }
    },
    "reporter": { "type": "string", "minLength": 1 },
    "snippet_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "url": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\x00-\\x20\\x7f]*$",
          "format": "uri"
        }
      }
    },
    "version": { "const": 1 }
  },
  "x-tribrach": {
    "rules": [
      {
        "lean": "CaptureSchema.rangesInOrder",
        "stamp": "5e5d8d5dfb2b0905",
        "doc": "Each range ends at or after its start, and starts after the previous range ends."
      }
    ]
  }
}
